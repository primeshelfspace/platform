# The two most expensive failure modes on this project are a missing
# authorisation check and a money arithmetic defect (TER-001 §4). Requiring a
# named reviewer on exactly those paths is a cheap control that survives team
# turnover in a way a review checklist does not.

# Default
*                                       @sugrpay/engineering

# Money. A defect here is a financial defect, not a rendering glitch.
/packages/kernel/src/money/             @sugrpay/engineering-leads @sugrpay/security

# Authorisation, tenancy and the permission matrix.
/packages/kernel/src/domain/roles.ts      @sugrpay/engineering-leads @sugrpay/security
/packages/kernel/src/tenancy.ts         @sugrpay/engineering-leads @sugrpay/security
/apps/api/src/modules/platform/tenancy/ @sugrpay/engineering-leads @sugrpay/security
/apps/api/src/modules/platform/auth/    @sugrpay/engineering-leads @sugrpay/security

# Row-level security policies and grants.
/apps/api/prisma/*/migrations/          @sugrpay/engineering-leads @sugrpay/security

# The public payment application. Every dependency change here is a PCI scope
# question, so the dependency manifest gets the same treatment as the code.
/apps/payment/                          @sugrpay/engineering-leads @sugrpay/security
/apps/payment/package.json              @sugrpay/engineering-leads @sugrpay/security

# Gateway adapters.
/apps/api/src/shared/adapters/gateway/  @sugrpay/engineering-leads @sugrpay/security
