{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "description": "One platform, many products — shared login, companies, brands and billing, with Sugrpay (invoicing) as the first product and HQ next.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "dev": "node scripts/dev.mjs",
    "dev:apps": "pnpm --parallel --filter \"./apps/*\" --filter @sugrpay/shared --filter @sugrpay/ui dev",
    "build": "pnpm --filter @sugrpay/shared --filter @sugrpay/ui build && pnpm --parallel --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "test": "pnpm -r test",
    "services:status": "node scripts/services.mjs status",
    "boot-check": "pnpm --filter @sugrpay/api build && node scripts/boot-check.mjs \"\" && node scripts/boot-check.mjs invoicing",
    "db:bootstrap": "pnpm --filter @sugrpay/api db:bootstrap",
    "db:generate": "pnpm --filter @sugrpay/api db:generate",
    "db:migrate": "pnpm --filter @sugrpay/api db:migrate",
    "db:reset": "pnpm --filter @sugrpay/api db:reset",
    "db:seed": "pnpm --filter @sugrpay/api db:seed",
    "db:migrate-legacy": "pnpm --filter @sugrpay/api db:migrate-legacy",
    "db:studio:platform": "pnpm --filter @sugrpay/api db:studio:platform",
    "db:studio:invoicing": "pnpm --filter @sugrpay/api db:studio:invoicing"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
