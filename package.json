{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "description": "The platform backend — one API and its databases: shared login, companies, brands, subscriptions and locations, with Sugrpay (invoicing) as the first product and HQ next. The web apps live in primeshelfspace/sugrpay-frontend.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "services:status": "node scripts/services.mjs status",
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build --env-mode=loose",
    "typecheck": "turbo run typecheck --env-mode=loose",
    "lint": "eslint .",
    "test": "turbo run test --env-mode=loose",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "check:deps": "node scripts/check-deps.mjs",
    "docs:api": "node scripts/api-reference.mjs && tsx scripts/openapi.mts",
    "check:docs": "node scripts/api-reference.mjs --check && tsx scripts/openapi.mts --check",
    "check": "pnpm format:check && pnpm lint && pnpm check:deps && pnpm check:docs && pnpm typecheck && pnpm test",
    "boot-check": "pnpm build && node scripts/boot-check.mjs platform && node scripts/boot-check.mjs sugrpay && node scripts/boot-check.mjs hq",
    "db:bootstrap": "node scripts/with-env.mjs tsx scripts/db/bootstrap.ts",
    "db:generate": "pnpm --filter @platform/platform-api db:generate && pnpm --filter @platform/sugrpay-api db:generate",
    "db:migrate": "pnpm --filter @platform/platform-api db:migrate && pnpm --filter @platform/sugrpay-api db:migrate",
    "db:reset": "pnpm --filter @platform/platform-api db:reset && pnpm --filter @platform/sugrpay-api db:reset && pnpm db:seed",
    "db:seed": "node scripts/with-env.mjs tsx scripts/db/seed.ts",
    "db:migrate-legacy": "node scripts/with-env.mjs tsx scripts/db/migrate-legacy.ts",
    "db:studio:platform": "pnpm --filter @platform/platform-api db:studio",
    "db:studio:invoicing": "pnpm --filter @platform/sugrpay-api db:studio",
    "db:move-zoho-connections": "node scripts/with-env.mjs tsx scripts/db/move-zoho-connections.ts",
    "db:rotate-credential-key": "node scripts/with-env.mjs tsx scripts/db/rotate-credential-key.ts",
    "stripe:register-payment-domains": "node scripts/with-env.mjs tsx scripts/stripe/register-payment-domains.ts"
  },
  "devDependencies": {
    "@platform/invoicing-contracts": "workspace:*",
    "@platform/kernel": "workspace:*",
    "@platform/platform-contracts": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "9.17.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "prettier": "^3.4.2",
    "stripe": "^17.5.0",
    "tsx": "^4.19.2",
    "turbo": "2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.18.1",
    "zod-to-json-schema": "3.24.1"
  }
}
