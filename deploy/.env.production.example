# ---------------------------------------------------------------------------
# Backend environment for a deployed server (staging or production).
#
#   cp deploy/.env.production.example .env && chmod 600 .env
#
# Replace every CHANGE-ME. Each setting is explained in .env.example; this file
# only notes what differs on a server. The API checks the whole file when it
# starts and refuses to boot with a list of anything missing or wrong.
# Full walkthrough: docs/guides/deploy-ec2.md
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# NODE_ENV is set by deploy/ecosystem.config.cjs, not here.
# APP_ENV=production refuses to boot with the fake payment gateway, the console
# mailer or local-disk storage. Use `staging` on the staging box.
APP_ENV=production
LOG_LEVEL=info
PLATFORM_API_PORT=4001
SUGRPAY_API_PORT=4002
HQ_API_PORT=4003
PLATFORM_INTERNAL_URL=http://127.0.0.1:4001
SUGRPAY_INTERNAL_URL=http://127.0.0.1:4002
# Shared secret for the APIs' /internal routes. Generate on the server:
#   openssl rand -hex 32
INTERNAL_API_KEY=
# Mail delivery webhook secret (openssl rand -hex 32); leave empty until a
# provider that reports deliveries is set up — see docs/integrations/mail-delivery.md.
MAIL_WEBHOOK_SECRET=

# --- Databases (RDS) -------------------------------------------------------
# One RDS instance holds both databases. pnpm db:bootstrap creates the
# databases and these four logins with the passwords given here, so pick new
# passwords (openssl rand -hex 24) rather than reusing the RDS master's.
# RDS requires TLS: keep sslmode=require.
PLATFORM_DATABASE_URL=postgresql://platform_app:CHANGE-ME@CHANGE-ME.rds.amazonaws.com:5432/platform?schema=public&sslmode=require
PLATFORM_DIRECT_DATABASE_URL=postgresql://platform_owner:CHANGE-ME@CHANGE-ME.rds.amazonaws.com:5432/platform?schema=public&sslmode=require
INVOICING_DATABASE_URL=postgresql://invoicing_app:CHANGE-ME@CHANGE-ME.rds.amazonaws.com:5432/invoicing?schema=public&sslmode=require
INVOICING_DIRECT_DATABASE_URL=postgresql://invoicing_owner:CHANGE-ME@CHANGE-ME.rds.amazonaws.com:5432/invoicing?schema=public&sslmode=require

# The RDS master user. Read only by `pnpm db:bootstrap`. You can delete this
# line after bootstrapping and add it back when a new module needs a database.
DATABASE_ADMIN_URL=postgresql://CHANGE-ME-master:CHANGE-ME@CHANGE-ME.rds.amazonaws.com:5432/postgres?sslmode=require

# --- Redis (ElastiCache, or redis://localhost:6379 on a small staging box) --
# Must use maxmemory-policy noeviction, or BullMQ refuses to start.
REDIS_URL=redis://CHANGE-ME.cache.amazonaws.com:6379

# --- Secrets ---------------------------------------------------------------
# openssl rand -base64 32, once for each. Different on every environment.
SESSION_SECRET=CHANGE-ME
# Back this one up in a password manager: losing or changing it makes every
# stored integration credential unreadable.
CREDENTIAL_ENCRYPTION_KEY=CHANGE-ME
# Signs the JWT a user carries into a product (openssl rand -hex 32).
PRODUCT_JWT_SECRET=CHANGE-ME-AT-LEAST-32-CHARACTERS

# --- Adapters --------------------------------------------------------------
PAYMENT_GATEWAY_DRIVER=stripe
# zoho once the Zoho app below is set up; fake until then.
ACCOUNTING_DRIVER=fake
MAIL_DRIVER=smtp
STORAGE_DRIVER=s3

# --- Workers and scheduler -------------------------------------------------
WORKER_CONCURRENCY=4
ENABLE_SCHEDULER=true
ZOHO_SCHEDULED_PULL_ENABLED=false

# --- Mail (SES over SMTP) --------------------------------------------------
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME
# Must be on the domain verified in SES.
MAIL_FROM="Sugrpay <billing@primeshelfspace.com>"

# --- Storage (S3) ----------------------------------------------------------
# Leave the access keys empty: the EC2 instance role grants access.
S3_BUCKET=CHANGE-ME
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Stripe Connect --------------------------------------------------------
# Test keys (sk_test_/pk_test_) on staging, live keys on production only.
STRIPE_SECRET_KEY=CHANGE-ME
STRIPE_PUBLISHABLE_KEY=CHANGE-ME
STRIPE_CONNECT_CLIENT_ID=CHANGE-ME
STRIPE_CONNECT_REDIRECT_URI=https://api.primeshelfspace.com/integrations/stripe/callback
# Signing secret of the webhook endpoint
# https://api.primeshelfspace.com/public/webhooks/stripe ("Events on Connected accounts").
STRIPE_WEBHOOK_SECRET=CHANGE-ME

# --- Square Connect (leave empty if unused) --------------------------------
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=production
SQUARE_CONNECT_REDIRECT_URI=https://api.primeshelfspace.com/integrations/square/callback

# --- Zoho Books (required only when ACCOUNTING_DRIVER=zoho) -----------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://api.primeshelfspace.com/integrations/zoho/callback
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# --- Public URLs -----------------------------------------------------------
# Used in emails, OAuth redirects and payment links. Must match nginx and the
# web apps' NEXT_PUBLIC_*_URL settings exactly.
API_PUBLIC_URL=https://api.primeshelfspace.com
ADMIN_PUBLIC_URL=https://app.primeshelfspace.com
PAYMENT_PUBLIC_URL=https://app.primeshelfspace.com/pay
ACCOUNTS_PUBLIC_URL=https://app.primeshelfspace.com/accounts
# Other browser origins allowed to call the API (comma-separated). The three
# public URLs above are always allowed.
CORS_EXTRA_ORIGINS=
