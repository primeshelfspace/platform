# ---------------------------------------------------------------------------
# Sugrpay Multi-Brand Invoicing — environment
#
# Copy to .env and adjust. Never commit .env — it is gitignored and gitleaks
# blocks it in CI. Every variable here is read by something; the API validates
# its own set at boot (packages/server/src/config/env.ts) and fails with a list of
# what is wrong rather than at 3am on the first request.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug

# --- Ports -----------------------------------------------------------------
# The web apps (and their ports) live in the sugrpay-frontend repository.
# Each API is its own program on its own port.
PLATFORM_API_PORT=4001
SUGRPAY_API_PORT=4002
HQ_API_PORT=4003
# How the APIs reach each other's /internal routes, and the shared key those
# routes require (any random string of 32+ characters; required in production).
PLATFORM_INTERNAL_URL=http://127.0.0.1:4001
SUGRPAY_INTERNAL_URL=http://127.0.0.1:4002
INTERNAL_API_KEY=local-only-change-me-0123456789abcdef0123456789
# Signs the mail delivery webhook (POST /public/webhooks/mail) — shared only
# with whatever posts delivery/bounce events. Unset: the webhook accepts nothing.
MAIL_WEBHOOK_SECRET=

# --- Data layer ------------------------------------------------------------
# One database per module (platform, invoicing; hq later). No module connects
# to another module's database — it calls that module's public API or listens
# to its events instead.
#
# *_DATABASE_URL is the runtime connection: the module's NON-owner role, so
# row-level security is actually enforced (an owner bypasses RLS entirely,
# TDD-001 §6.1), and it can connect to its own database only.
# *_DIRECT_DATABASE_URL is that database's owner: migrations, seeding, the
# event outbox and deliberate cross-tenant work.
PLATFORM_DATABASE_URL=postgresql://platform_app:platform_app@localhost:5432/platform?schema=public
PLATFORM_DIRECT_DATABASE_URL=postgresql://platform_owner:platform_owner@localhost:5432/platform?schema=public
INVOICING_DATABASE_URL=postgresql://invoicing_app:invoicing_app@localhost:5432/invoicing?schema=public
INVOICING_DIRECT_DATABASE_URL=postgresql://invoicing_owner:invoicing_owner@localhost:5432/invoicing?schema=public

# Superuser connection used ONLY by `pnpm db:bootstrap` to create the roles
# and databases above. Never read by the application. The default matches
# docker-compose's postgres superuser; a native PostgreSQL install usually
# has a `postgres` superuser instead.
DATABASE_ADMIN_URL=postgresql://sugrpay:sugrpay@localhost:5432/postgres

REDIS_URL=redis://localhost:6379

# --- Secrets ---------------------------------------------------------------
# Local development values only. Production values come from AWS Secrets Manager.
# Generate either with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-0000000000
# 32 bytes, base64. Wraps stored integration credentials at rest — including the
# Zoho refresh token. CHANGING OR LOSING THIS makes every stored credential
# undecryptable and every brand has to reconnect. Back it up before rotating.
# Generate your own — never reuse this placeholder, and never reuse the same
# value across environments. The API refuses to boot with the old literal
# value that used to be committed here (see env.ts): if any real environment
# still has it, that key — and every credential it has ever encrypted — must
# be rotated immediately.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_32

# --- Adapter selection -----------------------------------------------------
# stripe and zoho are the two real drivers with working adapters; everything
# else is fake by default (TER-001 §3.2). Each real driver's credentials are
# required only when it is selected, and the schema enforces that at boot.
PAYMENT_GATEWAY_DRIVER=fake   # fake | numbers | stripe
ACCOUNTING_DRIVER=fake        # fake | zoho
MAIL_DRIVER=smtp              # smtp | console  (postmark is rejected at boot)
STORAGE_DRIVER=local           # local | s3

# --- Workers and scheduler -------------------------------------------------
# Capped per queue by its own definition in queues.ts; this is the ceiling.
# ENABLE_SCHEDULER=false stops this process registering the repeatable cron
# jobs — useful when running more than one API instance, so only one owns them.
WORKER_CONCURRENCY=4
ENABLE_SCHEDULER=true
# Zoho → platform sync is webhook-driven (Brand Settings > Integrations >
# Zoho Books > Real-time Webhooks), plus the manual "Sync now" button. Set to
# true to also pull from Zoho on a timer at each brand's sync frequency.
ZOHO_SCHEDULED_PULL_ENABLED=false

# --- Mail ------------------------------------------------------------------
# Locally these point at the in-repo sink (pnpm services:up), which captures
# every message at http://localhost:1080 and never delivers to a real inbox.
#
# For a deployed environment MAIL_DRIVER stays `smtp` and these become the
# provider's SMTP endpoint — Postmark, SES, Resend and Mailgun all offer one.
# MAIL_FROM must be an address on a domain verified with that provider, or mail
# is rejected or silently spam-filed.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS, which is what port 465 expects. Port 587 uses STARTTLS and must
# leave this unset. Derived from the port when omitted, so most setups need it.
# SMTP_SECURE=true
MAIL_FROM="Sugrpay <billing@localhost>"

# --- Storage ---------------------------------------------------------------
# Brand and company logos, invoice PDFs, check images. `local` writes under
# STORAGE_LOCAL_PATH; `s3` uses the bucket below and is required in production
# (the schema refuses to boot production on local disk).
#
# Objects are written private and server-side encrypted, and every read is a
# short-lived presigned URL — so the bucket needs NO public access and NO bucket
# policy. Leave Block Public Access fully on.
#
# Leave S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY EMPTY on EC2 and attach an IAM
# role instead: the SDK picks up the instance profile and no long-lived key ever
# lands on the box. The role needs s3:PutObject, s3:GetObject, s3:DeleteObject
# and s3:HeadObject on arn:aws:s3:::BUCKET/*.
#
# S3_ENDPOINT is only for S3-compatible services (MinIO, R2). Leave it blank for
# real AWS or the SDK uses path-style addressing against the wrong host.
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Numbers Gateway (DEP-01: contract unverified, adapter blocked) --------
# Required only when PAYMENT_GATEWAY_DRIVER=numbers, which has no working
# adapter yet. NUMBERS_TOKENIZATION_LIBRARY_URL is not read by any code today —
# kept commented so the sandbox URL is not lost when the adapter is built.
NUMBERS_API_BASE_URL=
NUMBERS_API_KEY=
NUMBERS_WEBHOOK_SECRET=
# NUMBERS_TOKENIZATION_LIBRARY_URL=

# --- Stripe Connect (platform credentials; required when driver is stripe) --
# From the platform's own Stripe account. STRIPE_CONNECT_CLIENT_ID is the
# Connect application id (ca_…) under Settings → Connect → Onboarding options,
# and STRIPE_CONNECT_REDIRECT_URI must be registered there verbatim, port
# included. Brands authorise the platform rather than handing over keys, so the
# only per-brand fact stored is a non-secret account id.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_REDIRECT_URI=http://localhost:4001/integrations/stripe/callback
# One endpoint for every brand: register a single webhook in the platform
# dashboard listening to events "on connected accounts", pointed at
# {API_PUBLIC_URL}/public/webhooks/stripe. There is no per-brand secret.
STRIPE_WEBHOOK_SECRET=

# --- Square Connect (platform credentials) ----------------------------------
# From the platform's own Square Developer Dashboard application. Brands
# authorise the platform on Square's consent screen the same way they do for
# Stripe Connect; SQUARE_CONNECT_REDIRECT_URI must be registered on that
# application verbatim, port included.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox   # sandbox | production
SQUARE_CONNECT_REDIRECT_URI=http://localhost:4001/integrations/square/callback

# --- Authorize.net ----------------------------------------------------------
# Unlike Stripe/Square, Authorize.net has no OAuth consent screen for a
# platform to authorise against — each brand pastes its own API Login ID and
# Transaction Key on the Payment Gateways screen, and those are verified
# against Authorize.net's authenticateTestRequest before being stored. No
# platform-level credentials are needed here.

# --- Zoho Books ------------------------------------------------------------
# Required only when ACCOUNTING_DRIVER=zoho. Create a Server-based Application
# in the Zoho API console; the client id looks like 1000.XXXXXXXX. The redirect
# URI must match what is registered there exactly.
#
# ZOHO_API_DOMAIN must match the data centre the merchant's own Zoho account
# lives in (.com / .eu / .in / .com.au). The OAuth callback reads the correct
# api_domain from Zoho's token response, but this value is what request() builds
# URLs from — so a non-default region needs it changed here too.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4002/integrations/zoho/callback
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# --- Public URLs -----------------------------------------------------------
# Where each app is reachable from a browser (the web apps run from the
# sugrpay-frontend repository). Used in emails, OAuth redirects
# and the public payment links, so they must be externally correct — not
# localhost — in any deployed environment.
# The public front door (production: https://api.sugrpay.com, which routes each
# path to its API). Locally, the platform API.
API_PUBLIC_URL=http://localhost:4001
# The Swagger page at {API}/docs, generated from the code (pnpm docs:api). On by default.
API_DOCS_ENABLED=true
ADMIN_PUBLIC_URL=http://localhost:3000
PAYMENT_PUBLIC_URL=http://localhost:3000/pay
# Accounts: sign-in, team, brands, locations, billing. Set-password emails link here.
ACCOUNTS_PUBLIC_URL=http://localhost:3000/accounts
# Browsers may call the API only from the three addresses above. Add any other
# web-app address here, comma-separated (e.g. the Amplify default domain).
CORS_EXTRA_ORIGINS=

