# ---------------------------------------------------------------------------
# Fenwick Multi-Brand Invoicing — local environment
# Copy to .env and adjust. Never commit .env (gitleaks blocks it in CI).
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug

# DEV_API_BEARER_TOKEN is gone: apps/admin now signs in for real (FR-AUTH-001)
# and carries the session token issued by POST /auth/login. The seed script
# still writes a long-lived session for calling the API directly with curl —
# see `pnpm db:seed` output for the token and the sign-in credentials.

# --- Ports -----------------------------------------------------------------
API_PORT=4000
ADMIN_PORT=3000
PAYMENT_PORT=3001

# --- Data layer ------------------------------------------------------------
# Runtime connection. Uses the NON-owner application role so that row-level
# security is actually enforced — an owner bypasses RLS. See TDD-001 §6.1.
DATABASE_URL=postgresql://fenwick_app:fenwick_app@localhost:5432/fenwick?schema=public
# Migration/owner connection. Runs DDL and bypasses any pooler.
DIRECT_DATABASE_URL=postgresql://fenwick:fenwick@localhost:5432/fenwick?schema=public
DATABASE_APP_ROLE=fenwick_app

REDIS_URL=redis://localhost:6379

# --- Secrets ---------------------------------------------------------------
# Local development values only. Production values come from AWS Secrets Manager.
# Generate: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-0000000000
# 32-byte key, base64. Stands in for the KMS data key that wraps integration
# credentials at rest. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=fG2F3Ahrw1zN97gZNFRAVdYSVQsnaw8IsM6RMaP/70U=

# --- Ports and adapters ----------------------------------------------------
# stripe is the one real driver with a working adapter. It is multi-tenant via
# Stripe Connect: brands authorise this platform on Stripe's consent screen
# (admin app → Settings → Payment methods → Connect with Stripe), and only
# their account id is stored. The keys below are the PLATFORM's own, and there
# is exactly one set. Everything else is fake by default (TER-001 §3.2).
PAYMENT_GATEWAY_DRIVER=fake        # fake | numbers | stripe
ACCOUNTING_DRIVER=fake             # fake | zoho
MAIL_DRIVER=smtp                   # smtp | postmark | console
STORAGE_DRIVER=local               # local | s3

# --- Mail ------------------------------------------------------------------
# Locally these point at the in-repo sink (pnpm services:up), which captures
# every message at http://localhost:1080 and never delivers to a real inbox.
#
# For a deployed environment, MAIL_DRIVER stays `smtp` and these become the
# provider's SMTP endpoint — Postmark, SES, Resend, Mailgun and the rest all
# offer one. SMTP_SECURE is derived from the port when unset: implicit TLS on
# 465, STARTTLS on 587. MAIL_FROM must be an address on a domain you have
# verified with the provider, or mail is rejected or silently spam-filed.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE=true          # only for port 465; leave unset for 587
MAIL_FROM="Fenwick Invoicing <billing@localhost>"
# MAIL_DRIVER=postmark is rejected at boot — no adapter is bound for it. Use
# smtp with Postmark's SMTP endpoint instead.
POSTMARK_SERVER_TOKEN=

# --- Storage ---------------------------------------------------------------
# Brand and company logos, invoice PDFs, check images. STORAGE_DRIVER=local
# writes under STORAGE_LOCAL_PATH; `s3` uses the bucket below and is required
# in production (the env schema refuses to boot production on local disk).
#
# Objects are written private and server-side encrypted; nothing is ever public.
# Every read is a short-lived presigned URL, so the bucket needs NO public
# access and NO bucket policy — leave Block Public Access fully on.
#
# Leave S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY EMPTY on EC2 and attach an IAM
# role instead: the SDK picks up the instance profile automatically, and no
# long-lived key ever lands on the box. The role needs s3:PutObject,
# s3:GetObject, s3:DeleteObject and s3:HeadObject on arn:aws:s3:::BUCKET/*.
#
# S3_ENDPOINT is only for S3-compatible services (MinIO, R2); leave it blank
# for real AWS or the SDK will use path-style addressing against the wrong host.
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Numbers Gateway (DEP-01: contract unverified, adapter blocked) --------
NUMBERS_API_BASE_URL=
NUMBERS_API_KEY=
NUMBERS_WEBHOOK_SECRET=

# --- Stripe Connect (platform credentials; required when the driver is stripe)
# From the platform's own Stripe account. STRIPE_CONNECT_CLIENT_ID is the
# Connect application id under Settings → Connect → Onboarding options, and
# STRIPE_CONNECT_REDIRECT_URI must be registered there verbatim, port included.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_REDIRECT_URI=http://localhost:4000/integrations/stripe/callback
# One endpoint for every brand: register a single webhook in the platform
# dashboard listening to events "on connected accounts", pointed at
# {API_PUBLIC_URL}/public/webhooks/stripe. There is no per-brand secret.
STRIPE_WEBHOOK_SECRET=

# --- Zoho Books ------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/integrations/zoho/callback
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# --- Public URLs -----------------------------------------------------------
API_PUBLIC_URL=http://localhost:4000
ADMIN_PUBLIC_URL=http://localhost:3000
PAYMENT_PUBLIC_URL=http://localhost:3001

# Consumed by the browser bundles. Anything prefixed NEXT_PUBLIC_ is shipped to
# the client — never put a secret behind this prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PAYMENT_PUBLIC_URL=http://localhost:3001
# The payment app's CSP is `img-src 'self' data: blob:`, which blocks a brand
# logo served from a bucket. Set this to the bucket's origin when
# STORAGE_DRIVER=s3, or logos silently fail to render on the payment page —
# e.g. https://your-bucket.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_ASSET_ORIGIN=
# No NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: the payment app receives the platform
# publishable key AND the brand's connected account id from the invoice API at
# request time (PublicInvoiceView.stripePublishableKey / stripeAccountId).
# Which account applies depends on whose invoice is being paid, so neither can
# be baked into this build.
