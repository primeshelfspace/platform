{
  "name": "@platform/hq-api",
  "version": "0.1.0",
  "private": true,
  "description": "The HQ API (catalog, stock, purchase orders, stores) — a skeleton until HQ is built: its own program and port, reaching the platform only over HTTP. Answers /health only today.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ../../scripts/with-env.mjs node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@platform/kernel": "workspace:*",
    "@platform/server": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
