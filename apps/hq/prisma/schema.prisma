// HQ database — HQ's own data: stores and warehouses, catalog, stock,
// purchasing (built from HQ's stories). Today it holds HQ's read-only copy of
// the platform's brands, which HQ joins to and scopes row-level security by.
//
// This database belongs to ONE product. No other API may read or write it;
// they ask HQ's API or listen to its events instead. Common data (companies,
// users, roles, brands) lives on the platform: HQ asks the platform for it, and
// keeps copies only of what it must join to (brands), fed by platform events.

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("HQ_DATABASE_URL")
  directUrl = env("HQ_DIRECT_DATABASE_URL")
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

/// HQ's read-only copy of a platform brand, kept current by platform.brand.*
/// events (BrandReplicaProjector). hq_app may only read it.
model Brand {
  id          String      @id @db.Uuid
  merchantId  String      @map("merchant_id") @db.Uuid
  legalName   String      @map("legal_name")
  displayName String      @map("display_name")
  currency    String
  timezone    String
  themeColor  String      @map("theme_color")
  logoKey     String?     @map("logo_key")
  status      BrandStatus
  createdAt   DateTime    @map("created_at")
  /// The platform's updatedAt: the snapshot's version.
  updatedAt   DateTime    @map("updated_at")
  /// When this copy was last written from a platform event.
  replicatedAt DateTime   @default(now()) @map("replicated_at")

  @@index([merchantId])
  @@map("brand")
}

/// Platform events already applied, by id: delivery is at-least-once.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  topic       String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_event")
}
