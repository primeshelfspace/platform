// Fenwick Multi-Brand Invoicing — data model (TDD-001 §5).
//
// Conventions that are load-bearing, not stylistic:
//   *_minor   BigInt   money as signed 64-bit integer minor units (§5.3, NFR-INT-001).
//                      No Decimal and no Float appears anywhere in this file.
//   *_bp      Int      rates as integer basis points. 6% is 600.
//   quantity  Int      fixed point scaled by 10,000, so 1.5 is 15000.
//                      Ceiling is 214,748.3647 units on one line — see LineItem.
//   Applied rates are copied onto the invoice at issue and never re-read from
//   configuration, so a later settings change cannot alter history (NFR-INT-004).
//   Nothing is hard-deleted; financial records carry a status instead (NFR-INT-023).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// FRS-001 §3.2. Six roles reconciling the signed MVP with the prototype.
enum Role {
  MERCHANT_OWNER
  MERCHANT_ADMIN
  BRAND_ADMIN
  FINANCE_USER
  SALES_USER
  READ_ONLY
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

/// FR-BRD onboarding: legal structure of the business behind a brand.
enum BusinessType {
  SOLE_PROPRIETORSHIP
  LLC
  CORPORATION
  PARTNERSHIP
  NONPROFIT
}

/// FR-ONB: whether a merchant operates one brand or several. Chosen once,
/// right after company details — SINGLE auto-creates the one brand from
/// those details; MULTI hands off to brand-by-brand setup instead.
enum BrandStructure {
  SINGLE
  MULTI
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

/// TDD-001 §8.1. OVERDUE is deliberately absent — it is an overlay flag.
enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  WALLET
  ACH
  CHECK
  MANUAL
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SETTLED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum IntegrationProvider {
  ZOHO_BOOKS
  NUMBERS_GATEWAY
  SHOPIFY
  STRIPE
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  UNHEALTHY
  REVOKED
}

enum SyncDirection {
  PUSH
  PULL
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

/// TDD-001 §11.2.
enum SyncErrorClass {
  TRANSIENT
  AUTHENTICATION
  VALIDATION
  CONFLICT
  PERMANENT
}

enum CheckStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// Tenant root. Never referenced directly by operational queries; reached via brand.
model Merchant {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String         @map("contact_email")
  address      Json?
  plan         String         @default("standard")
  status       MerchantStatus @default(ACTIVE)

  /// Onboarding, FR-ONB. Staged company details, collected once before any
  /// Brand exists and copied from here into the first Brand — see
  /// MerchantService.setCompanyDetails / chooseBrandStructure. Everything
  /// up to and including brandStructure is derived, never stored as its own
  /// step, so it can never drift out of sync with what actually happened.
  /// onboardingComplete is the one fact that genuinely cannot be derived —
  /// SINGLE sets it the instant its one brand is created, but a MULTI
  /// merchant decides for itself when it is done adding brands, which
  /// nothing in the data implies on its own.
  companyLegalName     String?          @map("company_legal_name")
  /// "Doing business as" — the trading name, where it differs from the legal
  /// one. Optional because most businesses trade under their legal name.
  companyDba           String?          @map("company_dba")
  companyBusinessType  BusinessType?    @map("company_business_type")
  companyPhone         String?          @map("company_phone")
  companyEmail         String?          @map("company_email")
  companyMailingAddress Json?           @map("company_mailing_address")
  companyBillingAddress Json?           @map("company_billing_address")
  companyTaxId         String?          @map("company_tax_id")
  companyLogoKey       String?          @map("company_logo_key")
  brandStructure       BrandStructure?  @map("brand_structure")
  onboardingComplete   Boolean          @default(false) @map("onboarding_complete")

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  users     User[]
  brands    Brand[]
  auditLogs AuditLog[]

  @@map("merchant")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  merchantId   String     @map("merchant_id") @db.Uuid
  email        String
  passwordHash String     @map("password_hash")
  name         String
  role         Role
  status       UserStatus @default(INVITED)
  totpSecret   String?    @map("totp_secret")
  lastLoginAt  DateTime?  @map("last_login_at")
  failedLogins Int        @default(0) @map("failed_logins")
  lockedUntil  DateTime?  @map("locked_until")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  merchant       Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  assignments    UserBrandAssignment[]
  sessions       Session[]
  passwordTokens PasswordResetToken[]

  /// Email is unique within a merchant, not globally: the same person may hold
  /// accounts at two client organisations.
  @@unique([merchantId, email])
  @@index([merchantId])
  @@map("user")
}

/// Absent row means no access. Drives every scoped query (TDD-001 §5.2).
model UserBrandAssignment {
  userId    String   @map("user_id") @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@index([brandId])
  @@map("user_brand_assignment")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  sourceIp     String?   @map("source_ip")
  userAgent    String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// FR-AUTH-005/006 and FR-ONB: the emailed link that lets a brand-new owner —
/// or anyone who has forgotten their password — set one without already
/// holding a session.
///
/// Only the SHA-256 digest is stored, exactly like `session.token_hash`: the
/// raw token exists in the recipient's inbox and nowhere else, so a database
/// disclosure yields no usable links. Single use (`used_at`) and short-lived
/// (`expires_at`), because a set-password link is a bearer credential for the
/// whole account.
///
/// Outside row-level security for the same reason `session` is: it is consulted
/// to establish who someone is, so it cannot itself be scoped by that answer.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// ---------------------------------------------------------------------------
// Brand
// ---------------------------------------------------------------------------

model Brand {
  id             String      @id @default(uuid()) @db.Uuid
  merchantId     String      @map("merchant_id") @db.Uuid
  legalName      String        @map("legal_name")
  displayName    String        @map("display_name")
  salesPerson    String?       @map("sales_person")
  businessType   BusinessType? @map("business_type")
  phone          String?
  email          String?
  mailingAddress Json?         @map("mailing_address")
  billingAddress Json?         @map("billing_address")
  taxId          String?       @map("tax_id")
  currency       String      @default("USD")
  timezone       String      @default("America/New_York")
  themeColor     String      @default("#2D6A6A") @map("theme_color")
  logoKey        String?     @map("logo_key")
  status         BrandStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  merchant    Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  settings    BrandSettings?
  assignments UserBrandAssignment[]
  customers   Customer[]
  invoices    Invoice[]
  payments    Payment[]
  taxRates    TaxRate[]
  connections IntegrationConnection[]
  syncJobs    SyncJob[]
  checks      CheckSubmission[]

  @@index([merchantId])
  @@map("brand")
}

/// Separated from brand so sequence allocation locks a narrow row (TDD-001 §5.2).
model BrandSettings {
  brandId                String   @id @map("brand_id") @db.Uuid
  invoicePrefix          String   @default("INV") @map("invoice_prefix")
  nextSequence           Int      @default(1) @map("next_sequence")
  paymentTermsDays       Int      @default(30) @map("payment_terms_days")
  lateFeeRateBp          Int      @default(0) @map("late_fee_rate_bp")
  defaultTaxRateId       String?  @map("default_tax_rate_id") @db.Uuid
  cardFeeRateBp          Int      @default(0) @map("card_fee_rate_bp")
  partialPaymentEnabled  Boolean  @default(false) @map("partial_payment_enabled")
  reminderSchedule       Int[]    @default([]) @map("reminder_schedule")

  /// FR-PAY-005: which methods the public payment page offers for this
  /// brand. Card defaults on; everything else is opt-in because each has its
  /// own real-world prerequisite (a live gateway, an Apple/Google merchant
  /// registration) that does not exist until someone actually completes it.
  cardEnabled       Boolean @default(true) @map("card_enabled")
  applePayEnabled   Boolean @default(false) @map("apple_pay_enabled")
  googlePayEnabled  Boolean @default(false) @map("google_pay_enabled")
  achEnabled        Boolean @default(false) @map("ach_enabled")
  checkEnabled      Boolean @default(false) @map("check_enabled")

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

/// Rate held in basis points. Synced from Zoho where connected.
model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  label     String
  rateBp    Int      @map("rate_bp")
  zohoTaxId String?  @map("zoho_tax_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([brandId])
  @@map("tax_rate")
}

// ---------------------------------------------------------------------------
// Accounts receivable
// ---------------------------------------------------------------------------

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  brandId         String         @map("brand_id") @db.Uuid
  type            CustomerType   @default(BUSINESS)
  salutation      String?
  firstName       String?        @map("first_name")
  lastName        String?        @map("last_name")
  companyName     String?        @map("company_name")
  displayName     String         @map("display_name")
  email           String?
  phone           String?
  billingAddress  Json?          @map("billing_address")
  shippingAddress Json?          @map("shipping_address")
  zohoContactId   String?        @map("zoho_contact_id")
  notes           String?
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([brandId])
  @@index([brandId, status])
  @@index([zohoContactId])
  @@map("customer")
}

model Invoice {
  id         String        @id @default(uuid()) @db.Uuid
  brandId    String        @map("brand_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  number     String
  status     InvoiceStatus @default(DRAFT)

  invoiceDate DateTime @map("invoice_date") @db.Date
  dueDate     DateTime @map("due_date") @db.Date
  currency    String   @default("USD")

  subtotalMinor        BigInt @default(0) @map("subtotal_minor")
  taxRateBpApplied     Int    @default(0) @map("tax_rate_bp_applied")
  taxMinor             BigInt @default(0) @map("tax_minor")
  cardFeeRateBpApplied Int    @default(0) @map("card_fee_rate_bp_applied")
  cardFeeMinor         BigInt @default(0) @map("card_fee_minor")
  totalMinor           BigInt @default(0) @map("total_minor")
  /// Stored, not computed. Updated inside the same transaction as the payment,
  /// and verified by a reconciliation job (TDD-001 §5.3).
  balanceMinor         BigInt @default(0) @map("balance_minor")

  /// 128-bit random, hex. Separate from `number` because invoice numbers are
  /// sequential and guessable and this is what secures the public page (NFR-SEC-014).
  publicToken     String    @unique @map("public_token")
  publicTokenActive Boolean @default(true) @map("public_token_active")

  notes         String?
  internalNotes String?   @map("internal_notes")
  zohoInvoiceId String?   @map("zoho_invoice_id")
  taxRateId     String?   @map("tax_rate_id") @db.Uuid
  issuedAt      DateTime? @map("issued_at")
  firstViewedAt DateTime? @map("first_viewed_at")
  paidAt        DateTime? @map("paid_at")
  cancelledAt   DateTime? @map("cancelled_at")
  /// Set when a payment attempt starts, so a definitive failure can return the
  /// invoice to where it was (TDD-001 §8.2).
  previousStatus InvoiceStatus? @map("previous_status")
  overdue        Boolean        @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customer  Customer       @relation(fields: [customerId], references: [id])
  taxRate   TaxRate?       @relation(fields: [taxRateId], references: [id])
  lineItems LineItem[]
  payments  Payment[]
  events    InvoiceEvent[]
  checks    CheckSubmission[]

  @@unique([brandId, number])
  @@index([brandId, status])
  @@index([brandId, dueDate])
  @@index([customerId])
  @@map("invoice")
}

model LineItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  position    Int
  itemName    String  @map("item_name")
  description String?
  /// Fixed point scaled by 10,000. Int caps a single line at 214,748.3647
  /// units; widen to BigInt if a client ever bills beyond that.
  quantity    Int
  unitPriceMinor BigInt @map("unit_price_minor")
  /// Stored, not derived at read (TDD-001 §5.3).
  lineTotalMinor BigInt @map("line_total_minor")
  taxExempt      Boolean @default(false) @map("tax_exempt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@map("line_item")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  brandId   String        @map("brand_id") @db.Uuid
  method    PaymentMethod
  amountMinor BigInt      @map("amount_minor")
  currency  String        @default("USD")
  status    PaymentStatus @default(INITIATED)

  /// Uniquely indexed — the mechanism behind NFR-INT-010. A gateway that
  /// delivers the same settlement twice cannot create a second payment row.
  gatewayReference String? @unique @map("gateway_reference")
  /// hash(invoice_id, amount, attempt_nonce) — TDD-001 §8.3.
  idempotencyKey   String  @unique @map("idempotency_key")
  /// Gateway's own timestamp for the last event applied. Anything older is
  /// discarded, which is what makes out-of-order webhooks safe (NFR-INT-012).
  lastEventAt      DateTime? @map("last_event_at")

  declineReason String?   @map("decline_reason")
  settledAt     DateTime? @map("settled_at")
  refundedMinor BigInt    @default(0) @map("refunded_minor")
  zohoPaymentId String?   @map("zoho_payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  brand   Brand   @relation(fields: [brandId], references: [id])

  @@index([invoiceId])
  @@index([brandId, status])
  @@map("payment")
}

/// Append-only lifecycle history. Drives the invoice timeline.
model InvoiceEvent {
  id         String         @id @default(uuid()) @db.Uuid
  invoiceId  String         @map("invoice_id") @db.Uuid
  eventType  String         @map("event_type")
  fromStatus InvoiceStatus? @map("from_status")
  toStatus   InvoiceStatus? @map("to_status")
  actor      String
  payload    Json?
  occurredAt DateTime       @default(now()) @map("occurred_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, occurredAt])
  @@map("invoice_event")
}

/// Phase 2. Images are storage keys, never binary in the database.
model CheckSubmission {
  id            String      @id @default(uuid()) @db.Uuid
  invoiceId     String      @map("invoice_id") @db.Uuid
  brandId       String      @map("brand_id") @db.Uuid
  frontImageKey String      @map("front_image_key")
  backImageKey  String      @map("back_image_key")
  customerNote  String?     @map("customer_note")
  status        CheckStatus @default(SUBMITTED)
  reviewedBy    String?     @map("reviewed_by") @db.Uuid
  reviewNote    String?     @map("review_note")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, status])
  @@map("check_submission")
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model IntegrationConnection {
  id                   String              @id @default(uuid()) @db.Uuid
  brandId              String              @map("brand_id") @db.Uuid
  provider             IntegrationProvider
  status               ConnectionStatus    @default(DISCONNECTED)
  /// Envelope-encrypted with a KMS-held key. Never logged, never returned by
  /// any API, never included in an export (TDD-001 §15.2).
  encryptedCredentials String?             @map("encrypted_credentials")
  config               Json?
  lastSyncAt           DateTime?           @map("last_sync_at")
  /// Cursor for incremental pulls (FR-ZHO-030): the wall-clock time the last
  /// successful pull *started*, not the newest record seen — using pull-start
  /// avoids missing a record that gets modified while that pull is running.
  lastPulledAt         DateTime?           @map("last_pulled_at")
  health               String?
  /// Minutes between scheduled pulls for this brand (FR-ZHO-030). The
  /// 'scheduled-sync' cron itself ticks every minute — this is what it checks
  /// each connected brand against, not a separate per-brand cron registration.
  /// 1 is the honest floor for "Realtime": pull is inherently polling, since
  /// Zoho sends no webhooks this adapter listens for.
  pullFrequencyMinutes Int                 @default(15) @map("pull_frequency_minutes")
  /// Independent per-object-type push gates (FR-ZHO-011/012). Neither one
  /// blocks the hard technical prerequisite a disabled type still has to
  /// satisfy for another — see ZohoSyncService.pushCustomer's `viaCascade`.
  customerSyncEnabled  Boolean             @default(true) @map("customer_sync_enabled")
  invoiceSyncEnabled   Boolean             @default(true) @map("invoice_sync_enabled")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, provider])
  @@map("integration_connection")
}

/// The retry and error-log surface for FR-ZHO-021.
model SyncJob {
  id           String              @id @default(uuid()) @db.Uuid
  brandId      String              @map("brand_id") @db.Uuid
  provider     IntegrationProvider
  direction    SyncDirection
  objectType   String              @map("object_type")
  objectId     String?             @map("object_id")
  status       SyncStatus          @default(QUEUED)
  attemptCount Int                 @default(0) @map("attempt_count")
  errorClass   SyncErrorClass?     @map("error_class")
  /// The provider's verbatim message, so an operator sees what was actually
  /// said rather than a paraphrase.
  lastError    String?             @map("last_error")
  nextAttemptAt DateTime?          @map("next_attempt_at")
  completedAt  DateTime?           @map("completed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, status])
  @@index([status, nextAttemptAt])
  @@map("sync_job")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. The application role holds no UPDATE or DELETE grant on this
/// table — enforced in the RLS migration, not by convention (TDD-001 §5.2).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  brandId    String?  @map("brand_id") @db.Uuid
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  action     String
  objectType String   @map("object_type")
  objectId   String?  @map("object_id")
  sourceIp   String?  @map("source_ip")
  outcome    String
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, occurredAt])
  @@index([brandId, occurredAt])
  @@map("audit_log")
}
